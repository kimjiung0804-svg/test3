        "route": "/api/chat",
        "file": "app/api/chat/route.ts",
        "handler": "POST (streaming)"
      },
      {
        "route": "/api/chats",
        "file": "app/api/chats/route.ts",
        "handlers": ["GET", "POST"]
      },
      {
        "route": "/api/chats/[id]",
        "file": "app/api/chats/[id]/route.ts",
        "handlers": ["GET", "PATCH", "DELETE"]
      },
      {
        "route": "/api/chats/[id]/messages",
        "file": "app/api/chats/[id]/messages/route.ts",

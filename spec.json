  "security_and_environment": {
    "environment_variables": {
      "LOCAL_LLM_BASE_URL": {
        "required": true,
        "description": "Base URL for local LLM API (e.g., http://localhost:8000)",
        "example": "http://192.168.1.100:8000"
      },
      "LOCAL_EMBEDDING_URL": {
        "required": true,
        "description": "Base URL for local embedding service",
        "example": "http://localhost:9000/embed"
      },
      "UPLOAD_STORAGE_PATH": {
        "required": false,
        "default": "./storage/uploads",
        "description": "Local directory for uploaded files"
      },
      "VECTOR_DB_PATH": {
        "required": false,
        "default": "./storage/vectordb",
        "description": "Local directory for vector database"
      },
      "CHATS_PATH": {
        "required": false,
        "default": "./storage/chats",
        "description": "Local directory for chat session JSON files"
      },
      "MAX_FILE_SIZE_MB": {
        "required": false,
        "default": "50",
        "description": "Maximum file upload size in megabytes"
      }
    },
    "gitignore_entries": [
      ".env.local",
      "storage/",
      "*.db",
      "*.sqlite"
    ],
    "security_principles": [
      "All API endpoints, credentials, and file paths are read from environment variables",
      "No hardcoded secrets or absolute paths in code",
      "Files stored in local ./storage/ directory, excluded from git",
      "100% local processing - no external API calls",
      "No data leaves the local machine"
    ]
  },

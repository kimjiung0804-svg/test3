# Local LLM (OpenAI-compatible) endpoint — e.g. Ollama / Opencode
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2-vision:11b

# Local embedding service (optional — falls back to local-hash-v1 when unset/unreachable)
LOCAL_EMBEDDING_URL=http://localhost:9000/embed
# LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Local document uploads
STORAGE_PATH=./storage/uploads

# Local vector DB persistence
VECTORDB_PATH=./storage/vectordb

# Chat session history (JSON files)
CHATS_PATH=./storage/chats

# Optional upload limit
# MAX_FILE_SIZE_MB=50
